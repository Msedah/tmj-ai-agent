{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tmj-ai-agent",
  "main": "./src/index.js",
  "compatibility_date": "2026-09-29",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "SUPABASE_URL": "https://kiaaamxjtvenyaujpysf.supabase.co",
    "SUPABASE_ANON_KEY": "sb_publishable_F3MdZEjCS99N9oY9z7m9PQ_lwY0FUTr"
  },
  "assets": {
    "directory": "./public",
