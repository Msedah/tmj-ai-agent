{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tmj-ai-agent",
  "main": "./src/index.js",
  "compatibility_date": "2026-09-29",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "ai": { "binding": "AI" },
  "previews": {},
  "observability": {
    "enabled": true
  }
}
