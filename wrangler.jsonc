{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tmj-ai-agent",
  "main": "./src/index.js",
  "compatibility_date": "2026-09-29",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "SUPABASE_URL": "https://kiaaamxjtvenyaujpysf.supabase.co",
    "SUPABASE_ANON_KEY": "sb_publishable_F3MdZEjCS99N9oY9z7m9PQ_lwY0FUTr"
  },
  "rules": [
    { "type": "CompiledWasm", "globs": ["**/*.wasm"], "fallthrough": false }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "ai": { "binding": "AI" },
  "d1_databases": [
    {
      "binding": "USAGE_DB",
      "database_name": "tmj-ai-agent-usage",
      "database_id": "c52af0fa-2bb0-4c44-b741-6a7039f87d9f",
      "migrations_dir": "migrations/d1"
    }
  ],
  "previews": {
    "vars": {
      "SUPABASE_URL": "https://kiaaamxjtvenyaujpysf.supabase.co",
      "SUPABASE_ANON_KEY": "sb_publishable_F3MdZEjCS99N9oY9z7m9PQ_lwY0FUTr"
    },
    "ai": { "binding": "AI" }
  },
  "observability": {
    "enabled": true
  }
}
